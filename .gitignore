# ==========================================
# SentryPay - Master .gitignore
# ==========================================

# ------------------------------------------
# 1. AI / ML Models & Training Checkpoints
# ------------------------------------------
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.pkl
*.joblib
*.tflite
*.pb
*.pbtxt
*.model
*.tensor

# Large AI model folders & checkpoints
**/models/
**/model/
**/checkpoints/
**/checkpoint-*/
scam-language/model/
scam-language/models/

# Exception: Keep risk-engine baseline pre-trained model files required for risk engine service
!security-layers/risk-engine/models/model.pkl
!security-layers/risk-engine/models/scaler.pkl

# ------------------------------------------
# 2. Datasets & Raw/Cleaned Data
# ------------------------------------------
scam-language/datasets/
scam-language/dataset/
scam-check/#/
scam-check/**/data/
scam-check/**/raw/
scam-check/**/cleaned/
scam-check/**/final/
datasets/
dataset/

# Raw dataset table files
*.csv
*.parquet
*.feather

# ------------------------------------------
# 3. Archives & Compressed Files
# ------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.rar
*.7z
model.zip

# ------------------------------------------
# 4. Secrets & Environment Configurations
# ------------------------------------------
.env
.env.*
*.env
lib/core/config/secrets.dart
!lib/core/config/secrets.dart.example
!backend/.env.example
*.pem
*.key
*.p12

# ------------------------------------------
# 5. Flutter / Dart / Mobile / Web Build Outputs
# ------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
/build/
**/build/
/coverage/

# Android generated files & local config
android/.gradle/
android/local.properties
android/captures/
android/app/debug
android/app/profile
android/app/release
android/.cxx/
android/key.properties
**/*.keystore
**/*.jks

# iOS generated files
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/app.framework
ios/Flutter/ephemeral/
ios/Flutter/.last_build_id

# macOS / Linux / Windows ephemeral builds
macos/Flutter/ephemeral/
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------
# 6. Python Virtual Environments & Caches
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Microservices specific venvs and cache
backend/.venv/
backend/venv/
backend/env/
backend/__pycache__/
backend/*.py[cod]

scam-check/**/.venv/
scam-check/**/venv/
scam-check/**/env/
scam-check/**/__pycache__/
scam-check/**/*.py[cod]

security-layers/**/.venv/
security-layers/**/venv/
security-layers/**/env/
security-layers/**/__pycache__/
security-layers/**/*.py[cod]

# Python ML Caches
.cache/
.pytest_cache/
.mypy_cache/
huggingface/
transformers_cache/

# ------------------------------------------
# 7. IDE & Editor Files
# ------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.history
*.swp
*.swo

# ------------------------------------------
# 8. OS & Temp Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

*.log
*.tmp
*.temp
